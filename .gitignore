# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
.env
venv/
.venv/

# Raw source data — stays local (private pricing data)
agrolinking-forecast/data/raw/*.csv

# Processed master dataset — push this so cloud has chart data
# agrolinking-forecast/data/processed/*.csv   ← intentionally NOT ignored

# Raw model forecasts — too noisy, don't push
agrolinking-forecast/outputs/forecast_logs/model_forecasts_*.json

# Final forecasts — PUSH these so cloud dashboard has live data
# agrolinking-forecast/outputs/forecast_logs/final_forecasts_*.json  ← NOT ignored

# WhatsApp messages — outputs only, no need to version
agrolinking-forecast/outputs/whatsapp_messages/

# Model binaries
agrolinking-forecast/models/

# OS
.DS_Store
Thumbs.db

# Streamlit cache
.streamlit/secrets.toml
